    "%@ a month. Renews automatically unless canceled at least 24 hours before the period ends." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a month. Renews automatically unless canceled at least 24 hours before the period ends."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "월 %@. 기간이 끝나기 24시간 전까지 해지하지 않으면 자동으로 갱신돼요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月額%@。期間終了の24時間前までに解約しない限り自動で更新されます。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a month. Renews automatically unless cancelled at least 24 hours before the period ends."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每月 %@。除非在订阅期结束前至少 24 小时取消，否则将自动续订。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每月 %@。除非在訂閱期結束前至少 24 小時取消，否則將自動續訂。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ в месяц. Продлевается автоматически, если не отменить подписку минимум за 24 часа до конца периода."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ al mes. Se renueva automáticamente salvo que se cancele al menos 24 horas antes de que termine el periodo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pro Monat. Verlängert sich automatisch, sofern nicht mindestens 24 Stunden vor Ablauf des Zeitraums gekündigt wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ par mois. Renouvellement automatique, sauf annulation au moins 24 heures avant la fin de la période."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ al mese. Si rinnova automaticamente, a meno che non venga annullato almeno 24 ore prima della fine del periodo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ por mês. Renova automaticamente, a menos que seja cancelado pelo menos 24 horas antes do fim do período."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ต่อเดือน ต่ออายุอัตโนมัติ เว้นแต่จะยกเลิกก่อนสิ้นสุดรอบอย่างน้อย 24 ชั่วโมง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mỗi tháng. Tự động gia hạn trừ khi hủy ít nhất 24 giờ trước khi kỳ kết thúc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ měsíčně. Automaticky se obnovuje, pokud ho nezrušíš alespoň 24 hodin před koncem období."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ om måneden. Fornyes automatisk, medmindre det opsiges mindst 24 timer før periodens udløb."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ τον μήνα. Ανανεώνεται αυτόματα, εκτός αν ακυρωθεί τουλάχιστον 24 ώρες πριν από το τέλος της περιόδου."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kuukaudessa. Uusiutuu automaattisesti, ellei sitä peruuteta vähintään 24 tuntia ennen jakson päättymistä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ per bulan. Diperpanjang otomatis kecuali dibatalkan paling lambat 24 jam sebelum periode berakhir."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ i måneden. Fornyes automatisk med mindre det sies opp minst 24 timer før perioden utløper."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ per maand. Wordt automatisch verlengd, tenzij je minstens 24 uur voor het einde van de periode opzegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ miesięcznie. Odnawia się automatycznie, o ile nie zostanie anulowane co najmniej 24 godziny przed końcem okresu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ per månad. Förnyas automatiskt om det inte sägs upp minst 24 timmar före periodens slut."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayda %@. Dönem bitiminden en az 24 saat önce iptal edilmezse otomatik olarak yenilenir."
          }
        }
      }
    },
