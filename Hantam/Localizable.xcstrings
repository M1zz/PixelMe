    "%@ a month. Renews automatically unless canceled at least 24 hours before the period ends." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a month. Renews automatically unless canceled at least 24 hours before the period ends."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "월 %@. 기간이 끝나기 24시간 전까지 해지하지 않으면 자동으로 갱신돼요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月額%@。期間終了の24時間前までに解約しない限り自動で更新されます。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a month. Renews automatically unless cancelled at least 24 hours before the period ends."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每月 %@。除非在订阅期结束前至少 24 小时取消，否则将自动续订。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每月 %@。除非在訂閱期結束前至少 24 小時取消，否則將自動續訂。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ в месяц. Продлевается автоматически, если не отменить подписку минимум за 24 часа до конца периода."
          }
        }
      }
    },
