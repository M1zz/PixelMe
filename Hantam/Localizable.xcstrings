        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a year. Renews automatically unless cancelled at least 24 hours before the period ends."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每年 %@。除非在订阅期结束前至少 24 小时取消，否则将自动续订。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每年 %@。除非在訂閱期結束前至少 24 小時取消，否則將自動續訂。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ в год. Продлевается автоматически, если не отменить подписку минимум за 24 часа до конца периода."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ al año. Se renueva automáticamente salvo que se cancele al menos 24 horas antes de que termine el periodo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pro Jahr. Verlängert sich automatisch, sofern nicht mindestens 24 Stunden vor Ablauf des Zeitraums gekündigt wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ par an. Renouvellement automatique, sauf annulation au moins 24 heures avant la fin de la période."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ all’anno. Si rinnova automaticamente, a meno che non venga annullato almeno 24 ore prima della fine del periodo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ por ano. Renova automaticamente, a menos que seja cancelado pelo menos 24 horas antes do fim do período."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ต่อปี ต่ออายุอัตโนมัติ เว้นแต่จะยกเลิกก่อนสิ้นสุดรอบอย่างน้อย 24 ชั่วโมง"
