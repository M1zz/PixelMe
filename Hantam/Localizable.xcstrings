    "Check the beads or thread you have, and patterns use only those colors." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the beads or thread you have, and patterns use only those colors."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가진 비즈나 실을 체크하면 그 색만으로 도안을 만들어요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持っているビーズや糸にチェックすると、その色だけで図案を作ります。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the beads or thread you have, and patterns use only those colours."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勾选你手头有的拼豆或绣线，图纸就只会用这些颜色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勾選你手邊有的拼豆或繡線，圖紙就只會用這些顏色。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отметьте бусины или нитки, которые у вас есть, и в схемах будут только эти цвета."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca las cuentas o los hilos que tienes y los patrones usarán solo esos colores."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hake die Perlen oder das Garn ab, die du hast – die Vorlagen verwenden dann nur diese Farben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cochez les perles ou les fils que vous avez : les grilles n’utiliseront que ces couleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona le perline o i fili che hai e gli schemi useranno solo quei colori."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque as miçangas ou linhas que você tem, e os padrões usarão só essas cores."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกลูกปัดหรือไหมที่คุณมี แพตเทิร์นจะใช้เฉพาะสีเหล่านั้น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đánh dấu hạt hoặc chỉ bạn có, mẫu sẽ chỉ dùng những màu đó."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaškrtni korálky nebo nitě, které máš, a vzory budou používat jen tyto barvy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
