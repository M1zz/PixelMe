    "Everything stays readable with Increase Contrast on or if colors are hard to tell apart." : {
      "comment" : "Roadmap item detail: contrast and color",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대비를 높이거나 색을 구별하기 어려워도 내용을 알아볼 수 있어요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「コントラストを上げる」をオンにしても、色の区別が難しくても、内容を読み取れます。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays readable with Increase Contrast on or if colours are hard to tell apart."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启“增强对比度”或颜色不易分辨时，所有内容依然清晰可读。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「提高對比」或顏色不易分辨時，所有內容依然清晰可讀。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё остаётся читаемым при включённой повышенной контрастности и когда цвета трудно различить."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo se lee bien con Aumentar contraste activado o si cuesta distinguir los colores."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles bleibt lesbar, auch mit aktiviertem erhöhtem Kontrast oder wenn Farben schwer zu unterscheiden sind."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout reste lisible avec Augmenter le contraste activé ou si les couleurs sont difficiles à distinguer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto resta leggibile con Aumenta contrasto attivo o se i colori sono difficili da distinguere."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo continua legível com Aumentar Contraste ativado ou se as cores forem difíceis de distinguir."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังอ่านได้ชัดเจนเมื่อเปิดเพิ่มคอนทราสต์ หรือเมื่อแยกสีได้ยาก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi thứ vẫn dễ đọc khi bật Tăng độ tương phản hoặc khi khó phân biệt màu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vše zůstává čitelné se zapnutým zvýšeným kontrastem nebo když je těžké rozlišit barvy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
