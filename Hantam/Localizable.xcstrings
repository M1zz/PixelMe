    "Pick a photo of your pet, your face or a favorite character. Hantam turns it into a bead or cross-stitch pattern." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a photo of your pet, your face or a favorite character. Hantam turns it into a bead or cross-stitch pattern."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "반려동물, 내 얼굴, 좋아하는 캐릭터 사진을 고르면 한땀이 비즈나 십자수 도안으로 바꿔 줘요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペットや自分の顔、好きなキャラクターの写真を選ぶだけ。Hantamがビーズやクロスステッチの図案にします。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a photo of your pet, your face or a favourite character. Hantam turns it into a bead or cross-stitch pattern."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选一张宠物、自己或喜欢角色的照片，Hantam 会把它做成拼豆或十字绣图纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選一張寵物、自己或喜愛角色的照片，Hantam 會把它做成拼豆或十字繡圖紙。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите фото питомца, своё или любимого героя. Hantam превратит его в схему для термомозаики или вышивки крестом."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una foto de tu mascota, de ti o de tu personaje favorito. Hantam la convierte en un patrón de cuentas o de punto de cruz."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein Foto von deinem Haustier, von dir oder von einem Lieblingscharakter. Hantam macht daraus eine Vorlage für Bügelperlen oder Kreuzstich."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une photo de votre animal, de vous ou d’un personnage préféré. Hantam en fait une grille de perles ou de point de croix."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli la foto del tuo animale, di te o di un personaggio preferito. Hantam la trasforma in uno schema per perline o punto croce."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha a foto do seu pet, a sua ou a de um personagem favorito. O Hantam transforma em um padrão de miçangas ou de ponto cruz."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกรูปสัตว์เลี้ยง รูปตัวเอง หรือตัวละครที่ชอบ แล้ว Hantam จะเปลี่ยนเป็นแพตเทิร์นลูกปัดหรือครอสติช"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn ảnh thú cưng, ảnh của bạn hoặc nhân vật yêu thích. Hantam biến nó thành mẫu hạt hoặc thêu chữ thập."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyber fotku mazlíčka, sebe nebo oblíbené postavy. Hantam z ní udělá vzor z korálků nebo pro křížkový steh."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg et foto af dit kæledyr, dig selv eller en yndlingsfigur. Hantam laver det om til et perle- eller korsstingsmønster."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διάλεξε μια φωτογραφία του κατοικιδίου σου, τη δική σου ή ενός αγαπημένου χαρακτήρα. Το Hantam τη μετατρέπει σε σχέδιο για χάντρες ή σταυροβελονιά."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse kuva lemmikistäsi, itsestäsi tai lempihahmostasi. Hantam tekee siitä helmi- tai ristipistokuvion."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih foto hewan peliharaan, wajahmu, atau karakter favorit. Hantam mengubahnya jadi pola manik atau kristik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg et bilde av kjæledyret ditt, deg selv eller en favorittfigur. Hantam gjør det om til et perle- eller korsstingmønster."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een foto van je huisdier, van jezelf of van een favoriet personage. Hantam maakt er een kralen- of kruissteekpatroon van."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz zdjęcie zwierzaka, swoje lub ulubionej postaci. Hantam zamieni je we wzór na koraliki lub haft krzyżykowy."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj ett foto på ditt husdjur, dig själv eller en favoritfigur. Hantam gör det till ett pärl- eller korsstygnsmönster."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evcil hayvanının, kendinin ya da sevdiğin bir karakterin fotoğrafını seç. Hantam onu boncuk veya kanaviçe şemasına çevirir."
          }
        }
      }
    },
