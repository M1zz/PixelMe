    "Could not detect a face in this photo. Please try another photo or use manual crop." : {
      "comment" : "An alert message displayed when no face is detected in the selected image.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사진에서 얼굴을 감지할 수 없습니다. 다른 사진을 사용하거나 수동 자르기를 이용해 주세요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この写真から顔を検出できませんでした。別の写真を試すか、手動で切り抜いてください。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not detect a face in this photo. Please try another photo or use manual crop."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这张照片中没有检测到人脸。请换一张照片，或使用手动裁剪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這張照片中偵測不到人臉。請換一張照片，或使用手動裁切。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом фото не удалось найти лицо. Выберите другое фото или обрежьте вручную."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha detectado ninguna cara en esta foto. Prueba con otra o recorta a mano."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diesem Foto wurde kein Gesicht erkannt. Versuche ein anderes Foto oder schneide manuell zu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun visage détecté sur cette photo. Essayez-en une autre ou recadrez manuellement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun viso rilevato in questa foto. Prova con un’altra foto o ritaglia manualmente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível detectar um rosto nesta foto. Tente outra foto ou recorte manualmente."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจไม่พบใบหน้าในรูปนี้ ลองใช้รูปอื่นหรือครอบตัดเอง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không nhận diện được khuôn mặt trong ảnh này. Hãy thử ảnh khác hoặc cắt thủ công."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
