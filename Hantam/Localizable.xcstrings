          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ om året. Fornyes automatisk, medmindre det opsiges mindst 24 timer før periodens udløb."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ τον χρόνο. Ανανεώνεται αυτόματα, εκτός αν ακυρωθεί τουλάχιστον 24 ώρες πριν από το τέλος της περιόδου."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vuodessa. Uusiutuu automaattisesti, ellei sitä peruuteta vähintään 24 tuntia ennen jakson päättymistä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
