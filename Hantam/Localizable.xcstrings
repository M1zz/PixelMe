    },
    "Pets, faces, logos and characters all work. Photos with a clear subject turn out best." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pets, faces, logos and characters all work. Photos with a clear subject turn out best."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "반려동물, 얼굴, 로고, 캐릭터 모두 좋아요. 주인공이 또렷한 사진일수록 잘 나와요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペット、似顔絵、ロゴ、キャラクター、なんでもOK。被写体がはっきりした写真ほどきれいに仕上がります。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pets, faces, logos and characters all work. Photos with a clear subject turn out best."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宠物、人脸、标志和角色都可以。主体清晰的照片效果最好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寵物、人臉、標誌和角色都可以。主體清楚的照片效果最好。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подойдут питомцы, лица, логотипы и персонажи. Лучше всего получаются фото с чётким объектом."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sirven mascotas, caras, logotipos y personajes. Quedan mejor las fotos con un sujeto claro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haustiere, Gesichter, Logos und Figuren funktionieren alle. Fotos mit klarem Motiv gelingen am besten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animaux, visages, logos et personnages conviennent. Les photos au sujet bien net donnent les meilleurs résultats."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanno bene animali, visi, loghi e personaggi. Le foto con un soggetto ben definito vengono meglio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pets, rostos, logotipos e personagens funcionam. Fotos com um assunto bem definido ficam melhores."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สัตว์เลี้ยง ใบหน้า โลโก้ และตัวละครใช้ได้หมด รูปที่ตัวแบบชัดเจนจะออกมาสวยที่สุด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thú cưng, khuôn mặt, logo và nhân vật đều được. Ảnh có chủ thể rõ ràng cho kết quả đẹp nhất."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funguje to s mazlíčky, obličeji, logy i postavami. Nejlépe vyjdou fotky s výrazným motivem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kæledyr, ansigter, logoer og figurer virker alle sammen. Fotos med et tydeligt motiv bliver bedst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατοικίδια, πρόσωπα, λογότυπα και χαρακτήρες πάνε όλα. Οι φωτογραφίες με ξεκάθαρο θέμα βγαίνουν καλύτερα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lemmikit, kasvot, logot ja hahmot toimivat kaikki. Selkeäkohteiset kuvat onnistuvat parhaiten."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hewan peliharaan, wajah, logo, dan karakter semuanya bisa. Foto dengan objek yang jelas hasilnya paling bagus."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjæledyr, ansikter, logoer og figurer fungerer alle sammen. Bilder med et tydelig motiv blir best."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huisdieren, gezichten, logo’s en personages werken allemaal. Foto’s met een duidelijk onderwerp worden het mooist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdzą się zwierzęta, twarze, logo i postacie. Najlepiej wychodzą zdjęcia z wyraźnym motywem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Husdjur, ansikten, logotyper och figurer fungerar alla. Foton med ett tydligt motiv blir bäst."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evcil hayvanlar, yüzler, logolar ve karakterlerin hepsi olur. Konusu net fotoğraflar en iyi sonucu verir."
          }
        }
      }
    },
