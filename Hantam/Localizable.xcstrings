    "Bigger text never gets cut off — the screen rearranges itself neatly." : {
      "comment" : "Roadmap item detail: Dynamic Type layouts",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字を大きくしても切れずに、画面がきれいに並び替わります。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bigger text never gets cut off — the screen rearranges itself neatly."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放大文字也不会被截断，界面会自动整齐重排。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放大文字也不會被截斷，畫面會自動整齊重新排列。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крупный текст не обрезается — экран аккуратно перестраивается."
          }
        }
      }
    },
