    "Handy features are pointed out gently, right when they’re useful." : {
      "comment" : "Roadmap item detail: tips",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알아 두면 편한 기능을 알맞은 때에 살짝 알려 줘요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "便利な機能を、役立つタイミングでさりげなくご紹介します。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handy features are pointed out gently, right when they’re useful."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在恰当的时候，轻轻提示实用功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在恰當的時候，輕輕提示實用功能。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полезные функции подсказываются ненавязчиво и вовремя."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te señalamos con discreción las funciones útiles justo cuando las necesitas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktische Funktionen werden dezent genau dann gezeigt, wenn sie nützlich sind."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fonctions pratiques vous sont signalées discrètement, juste au bon moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le funzioni utili ti vengono suggerite con discrezione, proprio quando servono."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recursos úteis são apontados com delicadeza, na hora em que fazem diferença."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟีเจอร์ที่มีประโยชน์จะถูกแนะนำเบาๆ ในจังหวะที่ต้องใช้พอดี"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tính năng tiện lợi được nhắc nhẹ nhàng, đúng lúc bạn cần."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Užitečné funkce ti jemně ukážeme přesně ve chvíli, kdy se hodí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktiske funktioner bliver vist diskret, lige når de er nyttige."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι χρήσιμες λειτουργίες επισημαίνονται διακριτικά, ακριβώς όταν χρειάζονται."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hyödylliset ominaisuudet näytetään hienovaraisesti juuri kun niistä on hyötyä."
          }
