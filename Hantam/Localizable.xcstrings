    "Lonely single beads of an odd color are smoothed out in one tap." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lonely single beads of an odd color are smoothed out in one tap."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "혼자 튀는 색의 비즈 한 알을 한 번에 주변 색으로 정리해요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ぽつんと浮いた色のビーズを、ワンタップでまわりの色になじませます。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lonely single beads of an odd colour are smoothed out in one tap."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "孤零零的杂色拼豆，一键就能抚平。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "孤零零的雜色拼豆，一鍵就能撫平。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одинокие бусины выбивающегося цвета убираются одним касанием."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cuentas sueltas de un color distinto se eliminan con un toque."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einzelne Perlen in abweichender Farbe werden mit einem Tipp geglättet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les perles isolées d’une couleur différente sont lissées en une touche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le perline isolate di un colore diverso si eliminano con un tocco."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miçangas soltas de uma cor diferente somem com um toque."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลูกปัดเม็ดเดี่ยวสีแปลกๆ จัดการให้เนียนได้ในแตะเดียว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những hạt lẻ loi khác màu được dọn gọn chỉ bằng một lần chạm."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osamělé korálky jiné barvy se vyhladí jedním klepnutím."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enlige perler i en afvigende farve fjernes med ét tryk."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι μοναχικές χάντρες με παράταιρο χρώμα εξαφανίζονται με ένα πάτημα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksinäiset eriväriset helmet siivotaan yhdellä napautuksella."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manik tunggal berwarna janggal dirapikan hanya dengan satu ketukan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enslige perler i avvikende farge fjernes med ett trykk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eenzame losse kralen in een afwijkende kleur worden met één tik weggewerkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samotne koraliki w odstającym kolorze znikają jednym dotknięciem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensamma pärlor i avvikande färg jämnas ut med ett tryck."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renk uyumsuz tek başına kalmış boncuklar tek dokunuşla düzeltilir."
