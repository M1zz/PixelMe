    "Perler, Hama, Artkal and DMC are trademarks of their owners. Colors on screen may differ slightly from the real thing." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler, Hama, Artkal and DMC are trademarks of their owners. Colors on screen may differ slightly from the real thing."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler, Hama, Artkal, DMC는 각 회사의 상표예요. 화면의 색은 실물과 조금 다를 수 있어요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler、Hama、Artkal、DMCは各社の商標です。画面の色は実物と少し異なる場合があります。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler, Hama, Artkal and DMC are trademarks of their owners. Colours on screen may differ slightly from the real thing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler、Hama、Artkal 和 DMC 是各自所有者的商标。屏幕上的颜色可能与实物略有差异。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler、Hama、Artkal 和 DMC 是各自所有者的商標。螢幕上的顏色可能與實品略有差異。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler, Hama, Artkal и DMC — товарные знаки их владельцев. Цвета на экране могут немного отличаться от настоящих."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler, Hama, Artkal y DMC son marcas comerciales de sus propietarios. Los colores en pantalla pueden diferir un poco de los reales."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler, Hama, Artkal und DMC sind Marken ihrer Inhaber. Die Farben auf dem Bildschirm können leicht von den echten abweichen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler, Hama, Artkal et DMC sont des marques de leurs propriétaires. Les couleurs à l’écran peuvent différer légèrement des vraies."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler, Hama, Artkal e DMC sono marchi dei rispettivi proprietari. I colori sullo schermo possono differire leggermente da quelli reali."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler, Hama, Artkal e DMC são marcas registradas de seus proprietários. As cores na tela podem diferir um pouco das reais."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler, Hama, Artkal และ DMC เป็นเครื่องหมายการค้าของเจ้าของ สีบนหน้าจออาจต่างจากของจริงเล็กน้อย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler, Hama, Artkal và DMC là nhãn hiệu của các chủ sở hữu. Màu trên màn hình có thể khác đôi chút so với thực tế."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler, Hama, Artkal a DMC jsou ochranné známky svých vlastníků. Barvy na obrazovce se mohou od skutečných mírně lišit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler, Hama, Artkal og DMC er varemærker tilhørende deres ejere. Farverne på skærmen kan afvige lidt fra de virkelige."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι Perler, Hama, Artkal και DMC είναι εμπορικά σήματα των κατόχων τους. Τα χρώματα στην οθόνη μπορεί να διαφέρουν ελαφρά από τα πραγματικά."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler, Hama, Artkal ja DMC ovat omistajiensa tavaramerkkejä. Näytön värit voivat poiketa hieman todellisista."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler, Hama, Artkal, dan DMC adalah merek dagang pemiliknya. Warna di layar bisa sedikit berbeda dari aslinya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler, Hama, Artkal og DMC er varemerker som tilhører sine eiere. Fargene på skjermen kan avvike litt fra de virkelige."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler, Hama, Artkal en DMC zijn handelsmerken van hun eigenaren. Kleuren op het scherm kunnen een beetje afwijken van de echte kleuren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler, Hama, Artkal i DMC to znaki towarowe ich właścicieli. Kolory na ekranie mogą się nieznacznie różnić od prawdziwych."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler, Hama, Artkal och DMC är varumärken som tillhör sina ägare. Färgerna på skärmen kan skilja sig något från de verkliga."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler, Hama, Artkal ve DMC sahiplerinin ticari markalarıdır. Ekrandaki renkler gerçeğinden biraz farklı olabilir."
          }
        }
      }
    },
