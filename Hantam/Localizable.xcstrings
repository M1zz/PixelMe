      }
    },
    "Pets, faces, logos and characters all work. Photos with a clear subject turn out best." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pets, faces, logos and characters all work. Photos with a clear subject turn out best."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "반려동물, 얼굴, 로고, 캐릭터 모두 좋아요. 주인공이 또렷한 사진일수록 잘 나와요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペット、似顔絵、ロゴ、キャラクター、なんでもOK。被写体がはっきりした写真ほどきれいに仕上がります。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pets, faces, logos and characters all work. Photos with a clear subject turn out best."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宠物、人脸、标志和角色都可以。主体清晰的照片效果最好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寵物、人臉、標誌和角色都可以。主體清楚的照片效果最好。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подойдут питомцы, лица, логотипы и персонажи. Лучше всего получаются фото с чётким объектом."
          }
        }
      }
