    "Free during the trial, then %@ a month. Renews automatically unless canceled at least 24 hours before the period ends." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free during the trial, then %@ a month. Renews automatically unless canceled at least 24 hours before the period ends."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체험 기간에는 무료, 그 뒤 월 %@. 기간이 끝나기 24시간 전까지 해지하지 않으면 자동으로 갱신돼요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料体験のあとは月額%@。期間終了の24時間前までに解約しない限り自動で更新されます。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free during the trial, then %@ a month. Renews automatically unless cancelled at least 24 hours before the period ends."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "试用期内免费，之后每月 %@。除非在订阅期结束前至少 24 小时取消，否则将自动续订。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試用期間免費，之後每月 %@。除非在訂閱期結束前至少 24 小時取消，否則將自動續訂。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатно на время пробного периода, затем %@ в месяц. Продлевается автоматически, если не отменить подписку минимум за 24 часа до конца периода."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis durante la prueba y después %@ al mes. Se renueva automáticamente salvo que se cancele al menos 24 horas antes de que termine el periodo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während der Testphase kostenlos, danach %@ pro Monat. Verlängert sich automatisch, sofern nicht mindestens 24 Stunden vor Ablauf des Zeitraums gekündigt wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuit pendant l’essai, puis %@ par mois. Renouvellement automatique, sauf annulation au moins 24 heures avant la fin de la période."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis durante la prova, poi %@ al mese. Si rinnova automaticamente, a meno che non venga annullato almeno 24 ore prima della fine del periodo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grátis durante o teste, depois %@ por mês. Renova automaticamente, a menos que seja cancelado pelo menos 24 horas antes do fim do período."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟรีระหว่างทดลองใช้ จากนั้น %@ ต่อเดือน ต่ออายุอัตโนมัติ เว้นแต่จะยกเลิกก่อนสิ้นสุดรอบอย่างน้อย 24 ชั่วโมง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miễn phí trong thời gian dùng thử, sau đó %@ mỗi tháng. Tự động gia hạn trừ khi hủy ít nhất 24 giờ trước khi kỳ kết thúc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Během zkušební doby zdarma, poté %@ měsíčně. Automaticky se obnovuje, pokud ho nezrušíš alespoň 24 hodin před koncem období."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis i prøveperioden, derefter %@ om måneden. Fornyes automatisk, medmindre det opsiges mindst 24 timer før periodens udløb."
          }
        }
      }
    },
