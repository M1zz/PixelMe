          "stringUnit" : {
            "state" : "translated",
            "value" : "試用期間免費，之後每年 %@。除非在訂閱期結束前至少 24 小時取消，否則將自動續訂。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатно на время пробного периода, затем %@ в год. Продлевается автоматически, если не отменить подписку минимум за 24 часа до конца периода."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis durante la prueba y después %@ al año. Se renueva automáticamente salvo que se cancele al menos 24 horas antes de que termine el periodo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während der Testphase kostenlos, danach %@ pro Jahr. Verlängert sich automatisch, sofern nicht mindestens 24 Stunden vor Ablauf des Zeitraums gekündigt wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuit pendant l’essai, puis %@ par an. Renouvellement automatique, sauf annulation au moins 24 heures avant la fin de la période."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis durante la prova, poi %@ all’anno. Si rinnova automaticamente, a meno che non venga annullato almeno 24 ore prima della fine del periodo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grátis durante o teste, depois %@ por ano. Renova automaticamente, a menos que seja cancelado pelo menos 24 horas antes do fim do período."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟรีระหว่างทดลองใช้ จากนั้น %@ ต่อปี ต่ออายุอัตโนมัติ เว้นแต่จะยกเลิกก่อนสิ้นสุดรอบอย่างน้อย 24 ชั่วโมง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miễn phí trong thời gian dùng thử, sau đó %@ mỗi năm. Tự động gia hạn trừ khi hủy ít nhất 24 giờ trước khi kỳ kết thúc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Během zkušební doby zdarma, poté %@ ročně. Automaticky se obnovuje, pokud ho nezrušíš alespoň 24 hodin před koncem období."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis i prøveperioden, derefter %@ om året. Fornyes automatisk, medmindre det opsiges mindst 24 timer før periodens udløb."
          }
        }
      }
    },
