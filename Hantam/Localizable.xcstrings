    "Start with a photo or draw from scratch\nYour pixel art journey begins now" : {
      "comment" : "A description of the benefits of starting with a photo or drawing from scratch.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진으로 시작하거나 처음부터 그려 보세요\n픽셀 아트가 지금 시작돼요"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真から始めても、ゼロから描いてもOK\nドット絵づくりを始めましょう"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start with a photo or draw from scratch\nYour pixel art journey begins now"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用一张照片开始，或从零画起\n你的像素画之旅现在开始"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用一張照片開始，或從零畫起\n你的像素畫之旅現在開始"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните с фото или рисуйте с нуля\nВаш путь в пиксель-арте начинается"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza con una foto o dibuja desde cero\nTu viaje por el pixel art empieza ahora"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte mit einem Foto oder zeichne von null\nDeine Pixelart-Reise beginnt jetzt"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partez d’une photo ou dessinez de zéro\nVotre aventure pixel art commence maintenant"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parti da una foto o disegna da zero\nIl tuo viaggio nel pixel art inizia ora"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece com uma foto ou desenhe do zero\nSua jornada no pixel art começa agora"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เริ่มจากรูปถ่ายหรือวาดใหม่ตั้งแต่ต้น\nการเดินทางสู่พิกเซลอาร์ตของคุณเริ่มแล้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bắt đầu từ một tấm ảnh hoặc vẽ từ đầu\nHành trình pixel art của bạn bắt đầu từ bây giờ"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začni fotkou, nebo kresli od nuly\nTvoje cesta za pixel artem právě začíná"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start med et foto, eller tegn fra bunden\nDin rejse med pixelkunst begynder nu"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκίνα από μια φωτογραφία ή ζωγράφισε από το μηδέν\nΤο ταξίδι σου στο pixel art ξεκινά τώρα"
          }
        },
        "fi" : {
