    "Check the beads or thread you have, and patterns use only those colors." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the beads or thread you have, and patterns use only those colors."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가진 비즈나 실을 체크하면 그 색만으로 도안을 만들어요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持っているビーズや糸にチェックすると、その色だけで図案を作ります。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the beads or thread you have, and patterns use only those colours."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勾选你手头有的拼豆或绣线，图纸就只会用这些颜色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勾選你手邊有的拼豆或繡線，圖紙就只會用這些顏色。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отметьте бусины или нитки, которые у вас есть, и в схемах будут только эти цвета."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca las cuentas o los hilos que tienes y los patrones usarán solo esos colores."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hake die Perlen oder das Garn ab, die du hast – die Vorlagen verwenden dann nur diese Farben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cochez les perles ou les fils que vous avez : les grilles n’utiliseront que ces couleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona le perline o i fili che hai e gli schemi useranno solo quei colori."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque as miçangas ou linhas que você tem, e os padrões usarão só essas cores."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกลูกปัดหรือไหมที่คุณมี แพตเทิร์นจะใช้เฉพาะสีเหล่านั้น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đánh dấu hạt hoặc chỉ bạn có, mẫu sẽ chỉ dùng những màu đó."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaškrtni korálky nebo nitě, které máš, a vzory budou používat jen tyto barvy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afkryds de perler eller det garn, du har, så bruger mønstrene kun de farver."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επίλεξε τις χάντρες ή τις κλωστές που έχεις και τα σχέδια θα χρησιμοποιούν μόνο αυτά τα χρώματα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merkitse omistamasi helmet tai langat, niin kuviot käyttävät vain niitä värejä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Centang manik atau benang yang kamu punya, dan pola hanya akan memakai warna itu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huk av perlene eller garnet du har, så bruker mønstrene bare disse fargene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vink de kralen of het garen aan dat je hebt, en patronen gebruiken alleen die kleuren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznacz koraliki lub nici, które masz, a wzory będą używać tylko tych kolorów."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bocka för de pärlor eller det garn du har, så använder mönstren bara de färgerna."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elindeki boncuk veya iplikleri işaretle, şemalar yalnızca o renkleri kullansın."
          }
        }
      }
    },
