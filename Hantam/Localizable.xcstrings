    "Perler, Hama, Artkal beads and DMC thread. See the color number and how many you need of each." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler, Hama, Artkal beads and DMC thread. See the color number and how many you need of each."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler, Hama, Artkal 비즈와 DMC 실. 색 번호와 색마다 몇 개 필요한지 알려 줘요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler、Hama、ArtkalのビーズとDMCの糸に対応。色番号と、色ごとに必要な数がわかります。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler, Hama, Artkal beads and DMC thread. See the colour number and how many you need of each."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支持 Perler、Hama、Artkal 拼豆和 DMC 绣线，每种颜色的色号和需要的数量一目了然。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支援 Perler、Hama、Artkal 拼豆和 DMC 繡線，每種顏色的色號和需要的數量一目了然。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бусины Perler, Hama, Artkal и мулине DMC. Номер каждого цвета и нужное количество — на виду."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuentas Perler, Hama, Artkal e hilo DMC. Consulta el número de color y cuántas necesitas de cada uno."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bügelperlen von Perler, Hama, Artkal und DMC-Garn. Sieh die Farbnummer und wie viele du von jeder brauchst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perles Perler, Hama, Artkal et fil DMC. Voyez le numéro de couleur et la quantité nécessaire de chacune."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perline Perler, Hama, Artkal e filo DMC. Vedi il numero del colore e quante te ne servono di ciascuno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miçangas Perler, Hama, Artkal e fio DMC. Veja o número da cor e quantas você precisa de cada uma."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลูกปัด Perler, Hama, Artkal และไหม DMC ดูเลขสีและจำนวนที่ต้องใช้ของแต่ละสีได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hạt Perler, Hama, Artkal và chỉ DMC. Xem mã màu và số lượng cần cho từng màu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korálky Perler, Hama, Artkal a nitě DMC. Uvidíš číslo barvy a kolik kusů od každé potřebuješ."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perler-, Hama- og Artkal-perler og DMC-garn. Se farvenummeret og hvor mange, du skal bruge af hver."
          }
        }
      }
    },
    "Pets, faces, logos and characters all work. Photos with a clear subject turn out best." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pets, faces, logos and characters all work. Photos with a clear subject turn out best."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "반려동물, 얼굴, 로고, 캐릭터 모두 좋아요. 주인공이 또렷한 사진일수록 잘 나와요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペット、似顔絵、ロゴ、キャラクター、なんでもOK。被写体がはっきりした写真ほどきれいに仕上がります。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pets, faces, logos and characters all work. Photos with a clear subject turn out best."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宠物、人脸、标志和角色都可以。主体清晰的照片效果最好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寵物、人臉、標誌和角色都可以。主體清楚的照片效果最好。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подойдут питомцы, лица, логотипы и персонажи. Лучше всего получаются фото с чётким объектом."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sirven mascotas, caras, logotipos y personajes. Quedan mejor las fotos con un sujeto claro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haustiere, Gesichter, Logos und Figuren funktionieren alle. Fotos mit klarem Motiv gelingen am besten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animaux, visages, logos et personnages conviennent. Les photos au sujet bien net donnent les meilleurs résultats."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanno bene animali, visi, loghi e personaggi. Le foto con un soggetto ben definito vengono meglio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pets, rostos, logotipos e personagens funcionam. Fotos com um assunto bem definido ficam melhores."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สัตว์เลี้ยง ใบหน้า โลโก้ และตัวละครใช้ได้หมด รูปที่ตัวแบบชัดเจนจะออกมาสวยที่สุด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thú cưng, khuôn mặt, logo và nhân vật đều được. Ảnh có chủ thể rõ ràng cho kết quả đẹp nhất."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funguje to s mazlíčky, obličeji, logy i postavami. Nejlépe vyjdou fotky s výrazným motivem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kæledyr, ansigter, logoer og figurer virker alle sammen. Fotos med et tydeligt motiv bliver bedst."
          }
        }
      }
    },
