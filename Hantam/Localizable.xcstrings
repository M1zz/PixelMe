            "value" : "จ่ายครั้งเดียวใช้ได้ตลอด คุ้มกว่าสมัครสมาชิก 3 ปี"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trả một lần, dùng mãi — tiết kiệm hơn đăng ký 3 năm"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaplať jednou, používej navždy – úspora oproti 3 letům předplatného"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betal én gang, brug for evigt – spar i forhold til 3 års abonnement"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πλήρωσε μία φορά, χρησιμοποίησέ το για πάντα — εξοικονόμηση σε σχέση με 3 χρόνια συνδρομής"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksa kerran, käytä ikuisesti – säästät verrattuna 3 vuoden tilaukseen"
