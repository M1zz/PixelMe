    "Feel a light tap when you draw or finish something." : {
      "comment" : "Roadmap item detail: haptics",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그리거나 다 만들었을 때 가볍게 떨려서 알려 줘요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描いたときや完成したときに、軽い振動でお知らせします。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feel a light tap when you draw or finish something."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绘制或完成时，会有轻轻的触感反馈。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "繪製或完成時，會有輕輕的觸感回饋。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лёгкая вибрация, когда вы рисуете или что-то завершаете."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siente un ligero toque al dibujar o terminar algo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spüre ein leichtes Tippen, wenn du zeichnest oder etwas fertigstellst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentez une légère vibration quand vous dessinez ou terminez quelque chose."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senti un leggero tocco quando disegni o finisci qualcosa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinta um toquinho leve ao desenhar ou concluir algo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สัมผัสแรงสั่นเบาๆ เมื่อวาดหรือทำบางอย่างเสร็จ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cảm nhận một rung nhẹ khi bạn vẽ hoặc hoàn thành việc gì đó."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při kreslení nebo dokončení něčeho ucítíš lehké ťuknutí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mærk et let tryk, når du tegner eller bliver færdig med noget."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Νιώσε ένα ελαφρύ χτύπημα όταν ζωγραφίζεις ή ολοκληρώνεις κάτι."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunne kevyt naputus, kun piirrät tai saat jotain valmiiksi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rasakan getaran ringan saat kamu menggambar atau menyelesaikan sesuatu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjenn et lett trykk når du tegner eller blir ferdig med noe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voel een lichte tik als je tekent of iets afrondt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poczuj lekkie stuknięcie, gdy rysujesz lub coś skończysz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Känn en lätt knackning när du ritar eller blir klar med något."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çizerken veya bir şeyi bitirirken hafif bir titreşim hisset."
          }
        }
      }
    },
    "Fewer colors means fewer bags of beads to buy." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fewer colors means fewer bags of beads to buy."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "색이 적을수록 살 비즈 봉지도 줄어요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色が少ないほど、そろえるビーズも少なくて済みます。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fewer colours means fewer bags of beads to buy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "颜色越少，要买的拼豆就越少。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顏色越少，要買的拼豆就越少。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меньше цветов — меньше пакетиков бусин к покупке."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos colores significa menos bolsas de cuentas que comprar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weniger Farben bedeuten weniger Perlentüten zum Kaufen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moins de couleurs, c’est moins de sachets de perles à acheter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meno colori significa meno bustine di perline da comprare."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos cores significam menos pacotes de miçangas para comprar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยิ่งสีน้อย ยิ่งซื้อลูกปัดน้อยถุง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Càng ít màu thì càng ít túi hạt phải mua."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Méně barev znamená méně sáčků korálků k nákupu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Færre farver betyder færre poser perler at købe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λιγότερα χρώματα σημαίνουν λιγότερα σακουλάκια χαντρών για αγορά."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitä vähemmän värejä, sitä vähemmän helmipusseja tarvitsee ostaa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warna lebih sedikit berarti lebih sedikit kantong manik yang perlu dibeli."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Færre farger betyr færre poser med perler å kjøpe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minder kleuren betekent minder zakjes kralen om te kopen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mniej kolorów to mniej woreczków z koralikami do kupienia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Färre färger betyder färre påsar med pärlor att köpa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha az renk, satın alınacak daha az boncuk paketi demektir."
          }
        }
      }
    },
