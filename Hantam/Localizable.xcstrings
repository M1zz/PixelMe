        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mỗi năm. Tự động gia hạn trừ khi hủy ít nhất 24 giờ trước khi kỳ kết thúc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
